
  <div class="wrapper">
    <div class="author">
        <div class="author-avatar-wrapper">
          <img
            class="author-avatar"
            src="<%= theme.avatar %>"
            alt="avatar"
            loading="lazy"
          />
      </div>
      <!-- Motion treatment inspired by Uiverse.io / mobinkakei. -->
      <h2 class="author-name jia-brand" aria-label="JIA">
        <svg class="jia-word" viewBox="0 0 144 80" width="108" height="60" aria-hidden="true" focusable="false">
          <text class="jia-word-base" x="72" y="61" text-anchor="middle">𝙅𝙄𝘼</text>
          <text class="jia-word-outline" x="72" y="61" text-anchor="middle">𝙅𝙄𝘼</text>
          <circle class="jia-word-dot" r="2.5"><animateMotion path="M10 66Q37 74 70 66T130 66Q140 40 128 16Q74 7 16 16Q3 40 10 66Z" dur="3s" repeatCount="indefinite"></animateMotion></circle>
        </svg>
      </h2>
      <p class="author-bio"><%=theme.bio%></p>
    </div>
    <main class="home-feed" aria-label="Content" data-page="<%= page.current || 1 %>" data-total="<%= site.posts.length %>" data-next="<%= page.next ? url_for(page.next_link) : '' %>">
      <%-partial('partials/recent-posts')%>
      <% if (page.total > 1) { %><nav class="pager" aria-label="分页"><%- paginator({ prev_text: '上一页', next_text: '下一页' }) %></nav><% } %>
    </main>
  </div>
